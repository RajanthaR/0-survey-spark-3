{
  "name": "survey-spark-3",
  "version": "0.1.0",
  "description": "Trilingual EIP survey runner and admin analytics dashboard.",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Rajantha R Ambegala",
    "email": "rajantha.rc@gmail.com",
    "url": "https://github.com/RajanthaR/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajanthaR/survey-spark-3.git"
  },
  "bugs": {
    "url": "https://github.com/RajanthaR/survey-spark-3/issues"
  },
  "homepage": "https://github.com/RajanthaR/survey-spark-3#readme",
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "node server-node.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "deploy:preflight:static": "node scripts/deploy-preflight.mjs --static",
    "db:diff": "node scripts/db-diff.mjs",
    "db:diff:check": "node scripts/db-diff.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke-ssr.mjs",
    "smoke:db": "node scripts/smoke-db.mjs",
    "size": "bun scripts/check-bundle-budgets.ts && size-limit",
    "bundle:shape": "bun scripts/assert-bundle-shape.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "lighthouse:ci": "bun scripts/lighthouse-ci.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "dependencies": {
