# Supabase client values used by the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase server values used by TanStack Start server functions/routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap. The first admin promotion is limited to this email.
ADMIN_BOOTSTRAP_EMAIL=rajantha.rc@gmail.com

# Optional Cloudflare Turnstile bot protection.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
ALLOW_TURNSTILE_BYPASS=false

# Optional test/smoke targets.
BASE_URL=http://localhost:5173
PLAYWRIGHT_BASE_URL=

# GitHub nightly deploy-gate inputs map these values from repository
# variables/secrets before running deploy:preflight, smoke:db, and db:diff:check.
STAGING_BASE_URL=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_PUBLISHABLE_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_ACCESS_TOKEN=
STAGING_SUPABASE_DB_URL=
STAGING_TURNSTILE_SECRET=
STAGING_ADMIN_BOOTSTRAP_EMAIL=
STAGING_TURNSTILE_SITE_KEY=

# Optional dev-only illustration generation script.
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
