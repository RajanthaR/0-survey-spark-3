# Supabase client values used by the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase server values used by TanStack Start server functions/routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap. The first admin promotion is limited to this email.
ADMIN_BOOTSTRAP_EMAIL=rajantha.rc@gmail.com

# Optional Cloudflare Turnstile bot protection.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
ALLOW_TURNSTILE_BYPASS=false

# Full Turnstile kill-switch. Set BOTH to "true" to disable Turnstile entirely
# (client widget is not rendered; server skips verification) in ALL environments,
# including production. The production boot guard permits a missing
# TURNSTILE_SECRET only while TURNSTILE_DISABLED=true. Unset / "false" to restore
# bot protection. WARNING: with this on, anonymous survey writes have no bot
# protection — use only intentionally and temporarily.
TURNSTILE_DISABLED=false
VITE_TURNSTILE_DISABLED=false

# Redis URL for the multi-replica rate limiter. When unset, the limiter
# silently falls back to a per-process in-memory bucket (fine for local dev
# and tests, NOT safe across Railway replicas in production).
REDIS_URL=

# Node runtime listen address. Railway injects PORT automatically.
PORT=3000
HOSTNAME=0.0.0.0

# Optional test/smoke targets.
BASE_URL=http://localhost:5173
PLAYWRIGHT_BASE_URL=

# GitHub nightly deploy-gate inputs map these values from repository
# variables/secrets before running deploy:preflight, smoke:db, and db:diff:check.
STAGING_BASE_URL=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_PUBLISHABLE_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_ACCESS_TOKEN=
STAGING_SUPABASE_DB_URL=
STAGING_TURNSTILE_SECRET=
STAGING_ADMIN_BOOTSTRAP_EMAIL=
STAGING_TURNSTILE_SITE_KEY=

# Optional dev-only illustration generation script.
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
